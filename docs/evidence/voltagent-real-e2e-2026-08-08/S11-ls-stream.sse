},"strict":false}},{"type":"function","function":{"name":"read_file","description":"Read file content with optional line range (offset/limit). Prefer targeted reads for large files.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"file_path":{"type":"string","description":"Absolute path to the file to read"},"offset":{"default":0,"description":"Line offset to start reading from (0-indexed)","type":"number"},"limit":{"default":2000,"description":"Maximum number of lines to read","type":"number"}},"required":["file_path"],"additionalProperties":false},"strict":false}},{"type":"function","function":{"name":"write_file","description":"Write content to a file. Existing files require overwrite=true; parent directories can be created automatically.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"file_path":{"type":"string","description":"Absolute path to the file to write"},"content":{"type":"string","description":"Content to write to the file"},"overwrite":{"default":false,"description":"Whether to overwrite the file if it already exists","type":"boolean"},"create_parent_dirs":{"default":true,"description":"Whether to create parent directories if needed","type":"boolean"}},"required":["file_path","content"],"additionalProperties":false},"strict":false}},{"type":"function","function":{"name":"edit_file","description":"Edit a file by replacing exact text.\n\nUsage:\n- Read the file first and copy the exact text for old_string.\n- old_string must be unique unless replace_all=true.\n- Preserve indentation and whitespace exactly.\n- If read_file output includes line numbers, do not include those prefixes in old_string/new_string.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"file_path":{"type":"string","description":"Absolute path to the file to edit"},"old_string":{"type":"string","description":"String to be replaced (must matc