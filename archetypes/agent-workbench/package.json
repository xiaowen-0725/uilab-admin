{
  "name": "@uilab/agent-workbench",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Agent Workbench Archetype — Phase 3 Shell + real task lifecycle via local VoltAgent sidecar (not a production multi-tenant Runtime).",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node desktop/electron/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --browser.headless",
    "test:live-runtime": "VITE_WORKBENCH_LIVE_RUNTIME=1 vitest run --browser.headless tests/integration/workbench-runtime-slice.test.tsx tests/integration/workbench-plan-live.test.tsx tests/integration/workbench-question-live.test.tsx",
    "test:watch": "vitest --browser.headless",
    "test:browser": "vitest",
    "test:browser:install": "playwright install chromium --with-deps",
    "check:workbench": "node ../../scripts/check-workbench.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@pierre/diffs": "^1.3.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.22",
    "@uilab/foundation": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "motion": "^12.43.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.16.1",
    "shiki": "^4.4.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.4",
    "playwright": "1.59.1",
    "electron": "^37.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "vitest-browser-react": "^2.2.0"
  },
  "packageManager": "pnpm@10.33.3"
}
