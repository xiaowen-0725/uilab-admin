# DeepSeek (OpenAI-compatible) — copy to .env (gitignored)
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# Models: deepseek-chat | deepseek-reasoner | deepseek-v4-flash | deepseek-v4-pro
VOLTAGENT_MODEL=deepseek-chat

# Agent profile: minimal (DIY tools, default) | office (Agent + Workspace FS)
# AGENT_PROFILE=office

# Optional
# PORT=3141
# WORKSPACE_ROOT=/absolute/path/to/your/office-folder
# Office without WORKSPACE_ROOT → ~/VoltAgent-Office/workspace
# VOLTAGENT_MAX_STEPS=50
# LOG_LEVEL=info
