# DeepSeek (OpenAI-compatible) — copy to .env (gitignored)
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# Preferred: deepseek-v4-flash (default) | deepseek-v4-pro
# Legacy (being discontinued): deepseek-chat | deepseek-reasoner
VOLTAGENT_MODEL=deepseek-v4-flash
# chat (default, multi-step tools) | responses (DeepSeek documents flash only)
# VOLTAGENT_MODEL_API=chat

# Agent profile: minimal (DIY tools, default) | office (Agent + Workspace FS)
# AGENT_PROFILE=office

# Optional
# PORT=3141
# WORKSPACE_ROOT=/absolute/path/to/your/office-folder
# Office without WORKSPACE_ROOT → ~/VoltAgent-Office/workspace (O2 safe default)
# Never defaults to $HOME itself or the monorepo root for office.
# First boot creates the directory + README.md (does not overwrite).
# VOLTAGENT_MAX_STEPS=50
# LOG_LEVEL=info

# O5 long-run defaults (office)
# VOLTAGENT_MAX_STEPS=80
# VOLTAGENT_SUMMARIZATION=true
# VOLTAGENT_MEMORY=libsql
# VOLTAGENT_MEMORY_URL=file:/absolute/path/to/memory.db

# O4 optional MCP (docs knowledge + calendar). Omit = disabled (local FS only).
# MCP_DOCS_URL=https://your-docs-mcp.example
# MCP_DOCS_BEARER_TOKEN=
# MCP_CALENDAR_URL=https://your-calendar-mcp.example
# MCP_CALENDAR_BEARER_TOKEN=
# Or stdio:
# MCP_DOCS_COMMAND=npx
# MCP_DOCS_ARGS=-y,@example/feishu-docs-mcp
# MCP_CALENDAR_COMMAND=npx
# MCP_CALENDAR_ARGS=-y,@example/calendar-mcp
# MCP_TIMEOUT_MS=20000
# MCP_CHILD_ENV_KEYS=FEISHU_APP_ID,FEISHU_APP_SECRET
